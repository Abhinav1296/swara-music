# Copy this file to  scraper/.env  and paste YOUR MongoDB Atlas connection string.
#
# Where to get it:  Atlas dashboard -> Connect -> Drivers -> Python -> copy the string.
# Then replace <db_password> with the password you set for your database user.
#
# IMPORTANT:
#   - Do NOT commit scraper/.env (it's git-ignored).
#   - Do NOT paste this string into chat — it contains your password. Just save it here.

MONGODB_URI=mongodb+srv://USERNAME:<db_password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
