# Copy to .env and adjust if needed.

# Lyrica base URL — a personal instance that proxies lyrics (LRCLib/MusicBrainz)
# and full-length audio (JioSaavn). Defaults to the hosted Render instance.
LYRICA_URL=https://lyrica-jwtd.onrender.com

# Upstream request timeouts (seconds). Split so a slow stream lookup does not
# hang the worker forever while still allowing the upstream to reply.
LYRICA_CONNECT_TIMEOUT=5
LYRICA_READ_TIMEOUT=20

# Optional extra headers forwarded to Lyrica (e.g. an auth token). One
# "Header-Name: value" per line. Leave empty for the public instance.
# LYRICA_EXTRA_HEADERS=

# Default and max number of results returned per search
DEFAULT_LIMIT=25
MAX_LIMIT=50

# In-memory TTL (seconds) for cached /api/song-details successes
SONG_CACHE_TTL=21600

# Comma-separated list of allowed CORS origins (the Vite dev server)
CORS_ORIGINS=http://localhost:5173
